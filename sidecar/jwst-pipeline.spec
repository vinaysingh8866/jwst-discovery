# -*- mode: python ; coding: utf-8 -*-
"""PyInstaller spec for the JWST Discovery pipeline sidecar.

Builds ONE self-contained executable called ``jwst-pipeline`` that speaks the
NDJSON stdin/stdout protocol implemented in ``jwst_pipeline/__main__.py``.
Tauri ships it as an external binary (see ``src-tauri/tauri.conf.json`` ->
``bundle.externalBin`` and ``src-tauri/src/sidecar/manager.rs``).

Normal entry point is ``scripts/build_sidecar.sh``; to run PyInstaller by hand:

    python -m PyInstaller --noconfirm --clean sidecar/jwst-pipeline.spec

The spec generates a tiny launcher script (in the PyInstaller work dir) that
answers ``--version`` / ``--selftest`` before handing control to
``jwst_pipeline.__main__:main``.  ``__main__.py`` itself is untouched.
"""
import os
import sys
import tomllib
from pathlib import Path

from PyInstaller.utils.hooks import (
    collect_data_files,
    collect_submodules,
    copy_metadata,
    get_package_paths,
)

# ``SPECPATH`` / ``workpath`` / ``DISTPATH`` are injected by PyInstaller.
SIDECAR_DIR = Path(SPECPATH).resolve()  # noqa: F821
WORK_DIR = Path(workpath).resolve()  # noqa: F821
WORK_DIR.mkdir(parents=True, exist_ok=True)

# Make ``jwst_pipeline`` importable for the hook helpers even when the package
# is not pip-installed (the dev workflow runs it straight from this directory).
sys.path.insert(0, str(SIDECAR_DIR))

PYPROJECT = tomllib.loads((SIDECAR_DIR / "pyproject.toml").read_text())
VERSION = PYPROJECT["project"]["version"]

# --------------------------------------------------------------------------
# Launcher script (generated at build time)
# --------------------------------------------------------------------------
LAUNCHER_SRC = '''\
"""Generated by sidecar/jwst-pipeline.spec -- do not edit by hand."""
import multiprocessing
import sys

VERSION = "__VERSION__"

USAGE = (
    "jwst-pipeline " + VERSION + "\\n"
    "JWST Discovery pipeline sidecar.  Reads NDJSON commands on stdin and\\n"
    "writes NDJSON responses on stdout; logs go to stderr.\\n"
    "\\n"
    "  --version    print the version and exit\\n"
    "  --selftest   import every bundled scientific package and exit 0\\n"
)


def _selftest() -> int:
    import astropy  # noqa: F401
    import astroquery  # noqa: F401
    import matplotlib  # noqa: F401
    import photutils  # noqa: F401
    import polars  # noqa: F401
    import pyarrow  # noqa: F401
    import pyvo  # noqa: F401
    import reproject  # noqa: F401
    import requests  # noqa: F401
    import scipy  # noqa: F401
    import sep  # noqa: F401
    import skimage  # noqa: F401
    import sklearn  # noqa: F401

    matplotlib.use("Agg")
    import matplotlib.pyplot  # noqa: F401
    from jwst_pipeline.stages import STAGE_REGISTRY

    sys.stderr.write("selftest ok: %d stages registered\\n" % len(STAGE_REGISTRY))
    return 0


def _run() -> int:
    args = sys.argv[1:]
    if args and args[0] in ("--version", "-V"):
        sys.stdout.write("jwst-pipeline " + VERSION + "\\n")
        return 0
    if args and args[0] in ("--help", "-h"):
        sys.stdout.write(USAGE)
        return 0
    if args and args[0] == "--selftest":
        return _selftest()
    from jwst_pipeline.__main__ import main

    main()
    return 0


if __name__ == "__main__":
    multiprocessing.freeze_support()
    sys.exit(_run())
'''

LAUNCHER = WORK_DIR / "jwst_pipeline_launcher.py"
LAUNCHER.write_text(LAUNCHER_SRC.replace("__VERSION__", VERSION))

# --------------------------------------------------------------------------
# Hidden imports
# --------------------------------------------------------------------------
_SKIP_PARTS = {"tests", "test", "testing", "conftest", "benchmarks"}
# sklearn ships array-API shims for frameworks we deliberately exclude.
_SKIP_PREFIXES = (
    "sklearn.externals.array_api_compat.torch",
    "sklearn.externals.array_api_compat.cupy",
    "sklearn.externals.array_api_compat.dask",
    "sklearn.externals.array_api_extra",
    "scipy._lib.array_api_compat.torch",
    "scipy._lib.array_api_compat.cupy",
    "scipy._lib.array_api_compat.dask",
)


def _keep(name: str) -> bool:
    if name.startswith(_SKIP_PREFIXES):
        return False
    return not any(part in _SKIP_PARTS for part in name.split("."))


HIDDEN_PACKAGES = [
    "jwst_pipeline",
    "astropy",
    "astroquery",
    "pyvo",
    "sep",
    "photutils",
    "reproject",
    "polars",
    "pyarrow",
    "sklearn",
    "scipy",
    "skimage",
    "eazy",
    "requests",
]

hiddenimports = []
for _pkg in HIDDEN_PACKAGES:
    try:
        hiddenimports += collect_submodules(_pkg, filter=_keep)
    except Exception as exc:  # pragma: no cover - build-time diagnostics only
        print(f"[jwst-pipeline.spec] WARNING: collect_submodules({_pkg!r}) failed: {exc}")
        hiddenimports.append(_pkg)

hiddenimports += [
    # matplotlib: only the headless backend is wanted (see hooksconfig below).
    "matplotlib.backends.backend_agg",
    "matplotlib.backends.backend_pdf",
    "matplotlib.backends.backend_svg",
    # astropy helpers that are imported lazily / via entry points.
    "astropy_iers_data",
    "erfa",
    "yaml",
    "certifi",
    "PIL.Image",
    "PIL.PngImagePlugin",
    # stdlib modules used lazily by the sidecar
    "multiprocessing.pool",
    "multiprocessing.shared_memory",
    "concurrent.futures",
    "sqlite3",
    "html.parser",
    "xml.etree.ElementTree",
]
hiddenimports = sorted(set(hiddenimports))

# --------------------------------------------------------------------------
# Data files
# --------------------------------------------------------------------------
datas = []

# Packages whose non-Python resources are needed at runtime but have no
# PyInstaller hook (astropy, matplotlib, skimage, sklearn and pyarrow do have
# hooks and collect their own data, including astropy's IERS tables/config).
for _pkg in ["astroquery", "pyvo", "photutils", "reproject", "sep"]:
    try:
        datas += collect_data_files(_pkg, excludes=["**/tests/**/*", "tests/**/*"])
    except Exception as exc:  # pragma: no cover
        print(f"[jwst-pipeline.spec] WARNING: collect_data_files({_pkg!r}) failed: {exc}")

# dist-info metadata: photutils reads its own requirements through
# importlib.metadata at import time, and without the metadata the frozen
# sidecar fails with PackageNotFoundError. astropy and astroquery do the same
# for optional-dependency checks.
for _pkg in ["photutils", "astropy", "astroquery", "sep"]:
    try:
        datas += copy_metadata(_pkg)
    except Exception as exc:  # pragma: no cover
        print(f"[jwst-pipeline.spec] WARNING: copy_metadata({_pkg!r}) failed: {exc}")

# eazy: ship the small in-package data (zphot.param.default, Vega spectrum,
# IGM coefficients) plus the subset of the eazy-photoz repository that
# characterize.py references.  The full repo clone is ~200 MB (77 MB of it
# .git), far too much for a one-file binary that is unpacked on every launch.
_EAZY_PHOTOZ_SUBSET = [
    "filters/FILTER.RES.latest",
    "filters/FILTER.RES.latest.info",
    "templates/fsps_full/*",
    "templates/TEMPLATE_ERROR*",
    "templates/*.dat",
    "templates/*.def",
    "templates/*.param",
    "templates/*.txt",
]
try:
    datas += collect_data_files(
        "eazy",
        excludes=["data/eazy-photoz/**/*", "**/tests/**/*", "tests/**/*"],
    )
    _eazy_pkg = Path(get_package_paths("eazy")[1])
    _eazy_photoz = _eazy_pkg / "data" / "eazy-photoz"
    if _eazy_photoz.is_dir():
        _n = 0
        for _pattern in _EAZY_PHOTOZ_SUBSET:
            for _f in _eazy_photoz.glob(_pattern):
                if _f.is_file():
                    _rel = _f.relative_to(_eazy_pkg).parent
                    datas.append((str(_f), str(Path("eazy") / _rel)))
                    _n += 1
        print(f"[jwst-pipeline.spec] bundled {_n} eazy-photoz template/filter files")
        if _n == 0:
            print("[jwst-pipeline.spec] WARNING: eazy-photoz directory present but empty?")
    else:
        print(
            "[jwst-pipeline.spec] WARNING: eazy-photoz templates not found at "
            f"{_eazy_photoz}; the characterize stage will try to git-clone them at "
            "runtime.  Run scripts/build_sidecar.sh (it fetches them) or "
            "`python -c 'import eazy; eazy.fetch_eazy_photoz()'` before building."
        )
except Exception as exc:  # pragma: no cover
    print(f"[jwst-pipeline.spec] WARNING: eazy data collection failed: {exc}")

# Pre-computed PSF kernels (sidecar/data/psf_kernels/*.npy, git-ignored).
# jwst_pipeline/utils/psf_kernels.py resolves them relative to the package
# root, which inside the bundle is sys._MEIPASS -> data/psf_kernels.
_psf_dir = SIDECAR_DIR / "data" / "psf_kernels"
_psf_files = [p for p in _psf_dir.glob("*") if p.is_file() and not p.name.startswith(".")]
for _p in _psf_files:
    datas.append((str(_p), "data/psf_kernels"))
print(f"[jwst-pipeline.spec] bundled {len(_psf_files)} PSF kernel files")

# --------------------------------------------------------------------------
# Exclusions: GUI toolkits and ML frameworks the sidecar never uses.
# --------------------------------------------------------------------------
EXCLUDES = [
    "tkinter",
    "_tkinter",
    "Tkinter",
    "PyQt5",
    "PyQt6",
    "PySide2",
    "PySide6",
    "wx",
    "gi",
    "torch",
    "torchvision",
    "torchaudio",
    "jax",
    "jaxlib",
    "flax",
    "optax",
    "scarlet2",
    "pcigale",
    "cupy",
    "numba",
    "IPython",
    "ipykernel",
    "jupyter",
    "jupyter_client",
    "notebook",
    "pytest",
    "sphinx",
    "setuptools._distutils",
    # Pulled in transitively by scikit-image / scikit-learn / astropy / eazy
    # optional code paths that the pipeline never executes.  Verified by
    # importing the whole pipeline with each of these blocked in sys.modules.
    # Together they were ~290 MB of the 707 MB unpacked bundle.
    "cv2",
    "catboost",
    "av",
    "imageio",
    "plotly",
    "lxml",
    "pandas",
    "h5py",
    "cryptography",
    "xgboost",
    "lightgbm",
    "statsmodels",
    "seaborn",
    "bs4",
    "html5lib",
    "tifffile",
    "pywt",
    "sqlalchemy",
    "boto3",
    "botocore",
    "zarr",
    "fsspec",
    "aiohttp",
    "distributed",
]

block_cipher = None

a = Analysis(  # noqa: F821
    [str(LAUNCHER)],
    pathex=[str(SIDECAR_DIR)],
    binaries=[],
    datas=datas,
    hiddenimports=hiddenimports,
    hookspath=[],
    hooksconfig={
        # Only bundle the headless Agg backend (report.py calls matplotlib.use("Agg")).
        "matplotlib": {"backends": ["Agg", "PDF", "SVG"]},
    },
    runtime_hooks=[],
    excludes=EXCLUDES,
    win_no_prefer_redirects=False,
    win_private_assemblies=False,
    cipher=block_cipher,
    noarchive=False,
    optimize=0,
)

pyz = PYZ(a.pure, a.zipped_data, cipher=block_cipher)  # noqa: F821

exe = EXE(  # noqa: F821
    pyz,
    a.scripts,
    [],
    exclude_binaries=True,
    name="jwst-pipeline",
    debug=False,
    bootloader_ignore_signals=False,
    strip=False,
    upx=False,
    upx_exclude=[],
    console=True,
    disable_windowed_traceback=False,
    argv_emulation=False,
    target_arch=os.environ.get("JWST_PYINSTALLER_TARGET_ARCH") or None,
    codesign_identity=os.environ.get("JWST_CODESIGN_IDENTITY") or None,
    entitlements_file=os.environ.get("JWST_ENTITLEMENTS_FILE") or None,
)

# One-dir layout: jwst-pipeline/jwst-pipeline + jwst-pipeline/_internal/...
# Everything is unpacked at build time, so the process starts in a few seconds
# instead of unpacking ~2,800 files on every launch (one-file mode).
coll = COLLECT(  # noqa: F821
    exe,
    a.binaries,
    a.datas,
    strip=False,
    upx=False,
    upx_exclude=[],
    name="jwst-pipeline",
)
